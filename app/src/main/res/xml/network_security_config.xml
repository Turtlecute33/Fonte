<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only the system CAs: a CA that the user or a device admin adds cannot read the traffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
